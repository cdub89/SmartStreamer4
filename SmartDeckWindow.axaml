<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDRIQStreamer.App"
        mc:Ignorable="d" d:DesignWidth="360"
        x:Class="SDRIQStreamer.App.SmartDeckWindow"
        x:DataType="local:SmartDeckViewModel"
        Title="{Binding WindowTitle}"
        Width="360" MinWidth="356"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">

    <!-- Accelerators match the ones the operator already uses in FRStack.
         In-app only, by the phase-1 decision: no Win32 RegisterHotKey, so
         these fire while SmartDeck has focus and not while SmartSDR does. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding RfGainDownCommand}"/>
        <KeyBinding Gesture="F2" Command="{Binding RfGainUpCommand}"/>
        <KeyBinding Gesture="F3" Command="{Binding AgcThresholdDownCommand}"/>
        <KeyBinding Gesture="F4" Command="{Binding AgcThresholdUpCommand}"/>
    </Window.KeyBindings>

    <!-- The lit blue is no longer the deck's own brush: it is the app-wide
         accent from App.axaml, so the deck follows the Theme button like every
         other window (issue #63). It still means exactly one thing here, the
         value the radio currently holds. -->

    <Window.Styles>
        <!-- The telemetry strip under the header (2026-09-20 swap, see the row
             itself). Quiet on purpose: 10px, label and unit muted, only the
             value in the normal ink, because the number is the point and the
             frequency above it must stay the loudest thing in the block. At the
             header's 17 a reading looks equal to the frequency the radio is
             tuned to, which is the mistake the old footer already found and
             reverted one tier up. Label and value sit 5 apart, the gap the
             operator tuned for this same inline form when it carried RIT/XIT. -->
        <Style Selector="TextBlock.strip-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="TextBlock.strip-value">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.strip-unit">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- The mode readout is a control, not a caption: clicking it steps the
             slice through CW, LSB, USB, AM. It replaced a four-button row and
             its heading, which is the row the window got back (issue #59 live
             feedback). Deliberately not styled as a button, per the operator, so
             the only resting cue is that it reads as live state like the
             frequency beside it; the hover wash and the hand cursor are what
             say "clickable" before the click, because plain text that silently
             retunes the radio is otherwise a trap. -->
        <Style Selector="Button.mode-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <!-- Fluent gives a Button a 32px minimum height and a 1px border.
                 Both have to go or the readout stops being text: the minimum
                 would centre the mode inside a box taller than the frequency
                 beside it and push the whole header row down, which is the row
                 this control was added to save. -->
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Belt and braces with MinHeight above: if the template ever
                 hands the button a box taller than its text, the text still
                 sits on the row baseline instead of centring in the slack. -->
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="Button.mode-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mode-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mode-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- One heading per group, rather than a label beside every row: the
             40px gutter it replaces is 40px the buttons get back. -->
        <Style Selector="TextBlock.group-label">
            <Setter Property="FontSize" Value="10"/>
            <!-- Darker than the Gray these started at: at 10px that read as
                 disabled text rather than as a heading (operator-reported,
                 layout pass). Still well below the button labels, so the
                 headings name the group without competing with it. -->
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <!-- Negative top reclaims the line box's leading (operator, after
                 live test). At 10px the label gets roughly a 13px line box for
                 9px of glyph, measured off a screenshot, and that difference is
                 invisible padding above every group heading in the window. The
                 bottom 1px went at the same time; the buttons below already
                 pull up 2px with their own negative margin. Pulling harder than
                 2 starts closing the gap that separates a heading from the
                 control group above it. -->
            <Setter Property="Margin" Value="1,-2,0,0"/>
        </Style>

        <!-- Uniform margin rather than a trailing one, so a row of buttons ends
             flush with the group above it instead of 4px short. The host panel
             cancels the outer edge with a matching negative margin. -->
        <Style Selector="Button.deck-button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Fluent's default button face is light enough that a grid of
                 small labels reads washed out at a glance. Weight and ink both
                 lift a step; the lit styles below still override both. -->
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource AppInkBrush}"/>
        </Style>
        <Style Selector="Button.deck-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppInkBrush}"/>
        </Style>

        <!-- "Lit" is the current value the radio holds, not a pressed state.
             Set on the templated ContentPresenter as well as the Button so the
             fill survives Fluent's own hover and pressed brushes. -->
        <Style Selector="Button.lit">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.lit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>
        <Style Selector="Button.lit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>
        <Style Selector="Button.lit:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>

        <!-- A disabled deck button, declared after both the base rule and the
             lit ones on purpose: Avalonia resolves competing setters by
             declaration order, not selector specificity. The base rule above
             pins this same content presenter's ink at full strength, which is
             how Fluent's own disabled grey was being overridden, and that is
             what left DIV looking live on a radio that cannot do diversity
             (operator-reported on a 6400M, 2026-09-19). The button was really
             disabled and ignoring clicks the whole time; only the rendering
             lied. The grey therefore has to be restated here rather than
             dropped above, where the lit styles still need it.

             Opacity as well as ink, so a button that is lit and disabled fades
             its accent fill too rather than showing muted text on a
             full-strength accent. Applies to every deck button that can
             disable, not just DIV. -->
        <Style Selector="Button.deck-button:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.deck-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}"/>
        </Style>

        <!-- The control row at the foot of the deck: RF gain, AGC-T, RIT, XIT
             and PWR, label over value. The value is a step up from the 10px it
             had inline beside the label (operator, 2026-09-20: the footer slot
             has the room, and a value you steer by wheel should be easy to
             read). Starting sizes, expected to be tuned from a screenshot.

             Colour carries the engaged state for RIT and XIT, so ".on" MUST stay
             declared after the base styles: Avalonia resolves competing setters
             by declaration order, not selector specificity. -->
        <Style Selector="TextBlock.control-label">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.control-value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.control-label.on">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.control-value.on">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <!-- A disabled cell has to look disabled. The value is in the normal ink
             now, not the muted one the inline form used, so without this a row
             greyed for "no slice selected" would read as live. Same 0.5 the
             deck buttons use. -->
        <Style Selector="StackPanel.control-cell:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- Tips sit ABOVE the cell and wait. The default opens at the pointer
             after 400 ms, and here the pointer is on the value, so the tip
             landed on the very number being steered by wheel
             (operator-reported on the first pass, 2026-09-20). Top placement
             keeps the value in view; the longer delay means a quick wheel
             adjustment never raises a tip at all. Only these cells: every other
             tip on the deck belongs to a control whose value is not under it. -->
        <Style Selector="StackPanel.control-cell">
            <Setter Property="ToolTip.Placement" Value="Top"/>
            <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
            <Setter Property="ToolTip.ShowDelay" Value="1200"/>
        </Style>

        <!-- On the air (issue #69). The transmitting slice is usually also the
             selected one, so a chip carries both classes at once and this must
             win: Avalonia resolves competing setters by declaration order, not
             selector specificity, so these MUST stay declared after the lit
             styles above. Move them up and a transmitting chip reads blue.

             Same red through hover and pressed, unlike lit: the colour is
             saying the radio is keyed, and having it shift under the pointer
             would read as the state changing when it has not. -->
        <Style Selector="Button.tx">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tx /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTxBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTxBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>
        <Style Selector="Button.tx:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTxBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTxBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>
        <Style Selector="Button.tx:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTxBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTxBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>

        <!-- Always-on-top as a pushpin: hollow and grey when off, its inside
             filled with the same lit blue as a selected band button when on.
             Drawn as a vector rather than an icon-font glyph because the font's
             pushpin codepoints are outlines, so recolouring one only tinted the
             outline and the on state was hard to see (operator-reported twice,
             layout pass). A filled box behind the pin was also tried and read
             as a sixth radio control. -->
        <Style Selector="ToggleButton.pin">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.pin Path">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource AppOutlineBrush}"/>
        </Style>
        <Style Selector="ToggleButton.pin:checked Path">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.pin /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- The pin itself lights, not the box behind it. A filled box was
             tried first and read as a sixth radio control (operator-reported,
             layout pass). -->
        <Style Selector="ToggleButton.pin:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.pin:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <!-- 6 originally. Tried at 4 alone and the operator could not see the
         difference, which is the useful lesson: 2px is below the threshold that
         registers, so spacing has to be reclaimed from several places at once
         or not at all. Paired here with the group labels giving back their line
         leading, for about 5px at every group boundary rather than 2. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="10,8">

        <!-- Header. Answers slice, frequency and mode without opening anything;
             before the layout pass that state lived inside the slice dropdown's
             label, which is the one place it could not be read at a glance. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <!-- The readout centres inside the middle column rather than
                 spanning all three. Spanning centred it on the window, which is
                 fractionally truer (the chips and the pin are different widths)
                 but let the chips overlap it once there were enough slices to
                 reach the middle. Adding "Mode" to the readout widened it by
                 roughly a chip, which moved that collision from four slices to
                 three, so the tradeoff no longer holds: at one slice the two
                 layouts differ by about a pixel, and this one cannot collide.
                 Still declared first so the chips and the pin draw over it if a
                 station ever runs enough slices to squeeze the column anyway. -->
            <!-- A vertical stack around the readout row. Issue #73 put it here to
                 hang the RIT/XIT line beneath the frequency; that line moved to
                 the foot of the deck on 2026-09-20 and the telemetry strip took
                 the position as its own full-width row below the header, so
                 this now wraps one child. Kept deliberately for now: it is the
                 seam for the variant still to be tried, with the strip inside
                 this block directly under the frequency. If that variant is
                 rejected, fold the wrapper away.

                 The 6px top pad this carried is gone with the line. It existed
                 only to counterweight a small dim line hanging under the big
                 numerals; with nothing hanging, plain centring is right again.
                 The inner row is untouched: its baseline alignment took three
                 passes to get right (see the comments inside it). -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <!-- Bottom-aligned explicitly rather than left on the default
                     Stretch. Stretched, it filled whatever height the mode
                     button claimed and drew its text at the top of that box,
                     while the button centred its own content, so the mode read
                     as sitting lower than the frequency (operator-reported,
                     issue #59 live feedback). Every item on this row is
                     bottom-aligned now, which is what puts the two on a common
                     baseline; do not drop this back to the default. -->
                <!-- Wheel tunes the slice by the radio's own tune step (issue
                     #65). The handler hangs off the two readout TextBlocks
                     rather than a wrapper panel deliberately: this row's
                     baseline alignment took three passes to get right, and an
                     extra panel around these two is exactly the kind of change
                     that quietly moves it. Background="Transparent" is what
                     makes a TextBlock hit-testable in Avalonia; without it the
                     wheel event never reaches them. It is not a visual change.
                     The mode button beside them keeps its own hit area, so
                     wheeling over "CW" does not retune. -->
                <TextBlock Text="{Binding FrequencyText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom"
                           Background="Transparent"
                           PointerWheelChanged="OnFrequencyWheel"
                           ToolTip.Tip="Wheel: tune"/>
                <TextBlock Text="MHz" FontSize="10" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2"
                           Background="Transparent"
                           PointerWheelChanged="OnFrequencyWheel"/>
                <!-- Mode is the frequency's value-then-unit shape repeated at
                     the same size, not a size down: the pair reads as two equal
                     answers to "what am I on". Built smaller first, and a
                     smaller value bottom-aligned beside a larger one reads as
                     sitting low even on a shared baseline, because its cap
                     height starts further down (operator-reported twice, issue
                     #59 live feedback). Matching sizes is also what makes the
                     baselines exactly equal rather than nearly so, since the
                     two runs now have identical descent. Keep these four
                     attributes in step with the frequency and MHz above.
                     Hidden rather than blank with no slice, so the bare word
                     "Mode" never sits alone. -->
                <Button Classes="mode-toggle"
                        IsVisible="{Binding HasSelectedSlice}"
                        Command="{Binding CycleModeCommand}"
                        ToolTip.Tip="Click: next mode"
                        Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModeText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                        <TextBlock Text="Mode" FontSize="10" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </StackPanel>

            <!-- Centred on the row, like the readout and the pin (operator,
                 2026-08-25). Without this the chips take the cell's default
                 top alignment, which only showed once the RIT/XIT line made the
                 centre column taller than they are: the chips and the pin stayed
                 level with the frequency while the readout grew downward past
                 them, so the row read as top-aligned rather than centred. That
                 line left the header on 2026-09-20, but centring stays correct
                 and is what the in-block telemetry variant would need again. -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding SliceOptions}" Margin="-2"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeckOption">
                        <Button Classes="deck-button"
                                Classes.lit="{Binding IsCurrent}"
                                Classes.tx="{Binding IsTransmitting}"
                                Content="{Binding Label}"
                                MinWidth="26"
                                Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectSliceCommand}"
                                CommandParameter="{Binding Label}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ToggleButton Grid.Column="2"
                          Name="AlwaysOnTopCheck"
                          Classes="pin"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Keep on top"
                          IsCheckedChanged="OnAlwaysOnTopChanged">
                <!-- Thumbtack seen head-on: cap, shaft, flange, needle. The
                     enclosed outline is the point, since the checked style
                     fills its interior rather than the button behind it. -->
                <Path Data="M8,2 L16,2 L16,4 L14.5,4 L14.5,9 L18,13 L18,14 L12.8,14 L12,22 L11.2,14 L6,14 L6,13 L9.5,9 L9.5,4 L8,4 Z"
                      Stretch="Uniform"
                      Height="16"
                      StrokeThickness="1.3"
                      StrokeJoin="Round">
                    <!-- Tilted so the needle points down-left, matching the
                         orientation the Windows pin glyph used. A render
                         transform rather than rotated path data, so the
                         geometry above stays readable as a thumbtack. -->
                    <Path.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Path.RenderTransform>
                </Path>
            </ToggleButton>
        </Grid>

        <!-- Telemetry, read-only, directly under the header (operator request,
             2026-09-20): while keyed the eye is already on the frequency, so
             power and SWR belong beside it, and the wheel-driven controls that
             used to hang here moved to the foot of the deck, away from the
             frequency's own wheel target.

             Telemetry was moved up here once before, during issue #59, and put
             back. Per the operator (2026-09-20) that revert was about other
             usability problems in that pass, not about the position, so it is
             not a reason to avoid this one. The form differs too: a full-width
             row in the quiet inline type, not a narrow group of footer cells.

             FIXED CELLS, NOT A FLOWING LINE. Fwd and SWR change four times a
             second while keyed. A centred run of text re-centres every
             time "0.0" becomes "100", so the whole strip would shudder sideways
             on every dit, right under the frequency. Equal columns pin each
             reading in place. That is also why this is a row of its own rather
             than a line inside the header's centre block: equal cells need the
             full width, and the centre block is squeezed between the slice
             chips and the pin (see the collision notes in the header). The
             in-block variant is still to be tried at the operator's request.

             Order is the operator's (2026-09-20): Fwd, SWR, Temp, Volts. The two
             that move while keyed lead, the two slow, steady readings follow.
             The reverse order was tried the same day and put back; this is also
             the order the old footer used, less Ref.

             Reflected power (issue #69) was a fifth cell here and was removed
             end to end on 2026-09-20: it cluttered the line (operator), and SWR
             beside Fwd already answers the question an operator asks mid-QSO.
             The meter subscription, the accumulator channel, the record field
             and their tests went with it, so nothing is left unbound. If it
             ever comes back, the radio has its own REFPWR meter
             (Radio.ReflectedPowerDataReady); do not compute it from Fwd and
             SWR, which would read exactly 0 W on every good match because the
             SWR meter floors at 1.0. -->
        <!-- Bottom margin 5: breathing room before the Band heading (operator,
             first pass 2026-09-20). On top of the grid's RowSpacing of 4. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,5">
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Classes="strip-label" Text="Fwd"/>
                <TextBlock Classes="strip-value" Text="{Binding PowerText}"/>
                <TextBlock Classes="strip-unit" Text="W"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Classes="strip-label" Text="SWR"/>
                <TextBlock Classes="strip-value" Text="{Binding SwrText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Classes="strip-label" Text="Temp"/>
                <TextBlock Classes="strip-value" Text="{Binding TempText}"/>
                <TextBlock Classes="strip-unit" Text="C"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Classes="strip-label" Text="Volts"/>
                <TextBlock Classes="strip-value" Text="{Binding VoltsText}"/>
                <TextBlock Classes="strip-unit" Text="V"/>
            </StackPanel>
        </Grid>

        <!-- Band buttons. A band change is a write to Slice.Freq, not an API
             verb, so the per-band memory behind these lives in BandMemory. -->
        <StackPanel Grid.Row="2" IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Classes="group-label" Text="Band"/>
            <ItemsControl ItemsSource="{Binding BandOptions}" Margin="-2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeckOption">
                        <Button Classes="deck-button"
                                Classes.lit="{Binding IsCurrent}"
                                Content="{Binding Label}"
                                Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectBandCommand}"
                                CommandParameter="{Binding Label}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- RX and TX antenna share one row rather than owning one each: at two
             rows the deck stood twice the height of the operator's Stream Deck
             buttons beside it (issue #64). Antenna options come from the radio,
             so each group sizes itself to however many this model reports.
             The 2:1 column split matches the shape a 6600 reports once the
             transverter ports are filtered out (4 RX against 2 TX), so buttons
             read the same width across the seam; a radio reporting other counts
             renders one group slightly wider, which is cosmetic only. -->
        <Grid Grid.Row="3" ColumnDefinitions="2*,*" ColumnSpacing="10"
              IsEnabled="{Binding HasSelectedSlice}">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="group-label" Text="RX antenna"/>
                <ItemsControl ItemsSource="{Binding RxAntennaButtons}" Margin="-2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DeckOption">
                            <Button Classes="deck-button"
                                    Classes.lit="{Binding IsCurrent}"
                                    Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectRxAntennaCommand}"
                                    CommandParameter="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Classes="group-label" Text="TX antenna"/>
                <ItemsControl ItemsSource="{Binding TxAntennaButtons}" Margin="-2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DeckOption">
                            <Button Classes="deck-button"
                                    Classes.lit="{Binding IsCurrent}"
                                    Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectTxAntennaCommand}"
                                    CommandParameter="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Issue #76: the receive-chain strip, which replaced the RF gain and
             AGC-T steppers. (Those two have since moved again, with RIT and XIT,
             to the control row at the foot of the deck, 2026-09-20; what follows
             is the #76 record.) Those two moved up to the RIT/XIT row as inline
             pairs and their -/+ buttons were deleted; F1-F4 still drive them
             and the wheel already covered the whole group, so only a click
             target went. That is what paid for these four controls, and the
             deck comes out a line shorter than before rather than taller.

             APF, NR and NB are on/off only, so the wheel does nothing on them.
             See the remarks on SliceInfo.ApfOn before adding level steppers.

             DIV greys out rather than hiding on a radio that does not allow
             diversity (operator, 2026-09-19; his own 6400M is one). Hiding it
             would change the strip's width and alignment between radios, and
             the deck's whole geometry constraint is that nothing moves. A
             disabled button holds its cell and reads as "this radio cannot".

             IsEnabled rather than IsVisible, same as the header row: the deck
             holds one height in every state. -->
        <!-- Four equal columns filling the deck's fixed width, the same four the
             telemetry strip above uses, so the two rows line up cell for cell.
             A fifth column held the QRP/QRO power button until 2026-09-20, when
             the operator removed the button and its preset logic outright (see
             the TX power note in SmartDeckViewModel); a blank placeholder was
             considered and dropped, since a button that does nothing is a
             standing question on a control surface. Adding a column back is a
             one-line change when a fifth control actually exists.
             Spacing comes from the deck-button style's uniform 2px margin, the
             same as every other button on the deck: do not add per-button
             margins back here, they were what made the gutters uneven. -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*"
              IsEnabled="{Binding HasSelectedSlice}">
            <Button Grid.Column="0"
                    Classes="deck-button"
                    Classes.lit="{Binding IsDiversityOn}"
                    IsEnabled="{Binding IsDiversityAvailable}"
                    Content="DIV"
                    ToolTip.Tip="Diversity"
                    Command="{Binding ToggleDiversityCommand}"/>
            <Button Grid.Column="1"
                    Classes="deck-button"
                    Classes.lit="{Binding IsNbOn}"
                    Content="NB"
                    ToolTip.Tip="Noise blanker"
                    Command="{Binding ToggleNbCommand}"/>
            <Button Grid.Column="2"
                    Classes="deck-button"
                    Classes.lit="{Binding IsNrOn}"
                    Content="NR"
                    ToolTip.Tip="Noise reduction"
                    Command="{Binding ToggleNrCommand}"/>
            <Button Grid.Column="3"
                    Classes="deck-button"
                    Classes.lit="{Binding IsApfOn}"
                    Content="APF"
                    ToolTip.Tip="Audio peaking filter"
                    Command="{Binding ToggleApfCommand}"/>
        </Grid>

        <!-- The control row: RF gain, AGC-T, RIT, XIT and PWR, in the footer the
             telemetry used to hold (operator request, 2026-09-20; order is the
             operator's). Label over value, and a whole cell is the target, so
             the wheel and the click land on something far bigger than the four
             characters they had inline under the frequency.

             What each control answers is unchanged, and follows the deck's one
             rule, a control answers whatever it actually has. RIT and XIT have
             a state and a value: click engages or releases, wheel shifts the
             offset 10 Hz, and colour shows engaged. Both are always visible, so
             XIT engaged on the Maestro cannot sit hidden. RF gain, AGC-T and PWR
             have a value and no state, so they take the wheel and ignore the
             click. F1 to F4 still drive RF gain and AGC-T, though the tips no
             longer say so (operator, 2026-09-20: keep the tips short). Background is
             Transparent only because that is what makes a panel hit-testable in
             Avalonia; it is not a visual change. Wheel-only would be
             undiscoverable, hence the tooltips. No hover cue, by the operator's
             choice for now; revisit if the cells read as read-only.

             PWR is the transmit power SETTING, in watts, and the only power
             control on the deck since the QRP/QRO button went (2026-09-20). One
             percent of rated output a notch: 1 W on a FLEX, 5 W on an Aurora. It
             is not "Fwd" in the strip, which is measured output and reads zero
             on receive. No click and no modifier key, by the operator's choice:
             a big change is made in SmartSDR or on the Maestro.

             IsEnabled, not IsVisible: the deck holds one height in every state.
             Do not switch this to IsVisible. -->
        <!-- No divider above this row (operator, 2026-09-20): the rule that
             fenced off the read-only telemetry footer made no sense once the
             row became controls, which belong with the buttons above them.
             Top margin 2, on top of RowSpacing 4. It was 6, exactly what the
             divider had occupied, and the operator tightened it on 2026-09-20
             once the button row above lost its fifth button and the two rows
             read as one group. -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,*" IsEnabled="{Binding HasSelectedSlice}" Margin="0,2,0,0">
            <StackPanel Grid.Column="0"
                        Classes="control-cell"
                        Background="Transparent"
                        IsEnabled="{Binding CanAdjustRfGain}"
                        PointerWheelChanged="OnRfGainWheel"
                        ToolTip.Tip="Wheel: adjust">
                <TextBlock Classes="control-label" Text="RF Gain"/>
                <TextBlock Classes="control-value" Text="{Binding RfGainText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Classes="control-cell"
                        Background="Transparent"
                        PointerWheelChanged="OnAgcThresholdWheel"
                        ToolTip.Tip="Wheel: adjust">
                <TextBlock Classes="control-label" Text="AGC-T"/>
                <TextBlock Classes="control-value" Text="{Binding AgcThresholdText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Classes="control-cell"
                        Background="Transparent"
                        PointerWheelChanged="OnRitWheel"
                        Tapped="OnRitTapped"
                        ToolTip.Tip="Click: on/off. Wheel: 10 Hz">
                <TextBlock Classes="control-label" Classes.on="{Binding IsRitEnabled}" Text="RIT"/>
                <TextBlock Classes="control-value" Classes.on="{Binding IsRitEnabled}" Text="{Binding RitText}"/>
            </StackPanel>
            <StackPanel Grid.Column="3"
                        Classes="control-cell"
                        Background="Transparent"
                        PointerWheelChanged="OnXitWheel"
                        Tapped="OnXitTapped"
                        ToolTip.Tip="Click: on/off. Wheel: 10 Hz">
                <TextBlock Classes="control-label" Classes.on="{Binding IsXitEnabled}" Text="XIT"/>
                <TextBlock Classes="control-value" Classes.on="{Binding IsXitEnabled}" Text="{Binding XitText}"/>
            </StackPanel>
            <StackPanel Grid.Column="4"
                        Classes="control-cell"
                        Background="Transparent"
                        IsEnabled="{Binding CanAdjustTxPower}"
                        PointerWheelChanged="OnTxPowerWheel"
                        ToolTip.Tip="Wheel: watts">
                <TextBlock Classes="control-label" Text="PWR"/>
                <TextBlock Classes="control-value" Text="{Binding TxPowerText}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
