<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDRIQStreamer.App"
        xmlns:flex="clr-namespace:SDRIQStreamer.FlexRadio;assembly=SmartStreamer4.FlexRadio"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="366"
        x:Class="SDRIQStreamer.App.SmartDeckWindow"
        x:DataType="local:SmartDeckViewModel"
        Title="SmartDeck"
        Width="420" Height="366"
        MinWidth="380" MinHeight="350"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Telemetry readouts are glanced at mid-QSO, so the value is large and
             the label small. Tabular figures keep the numbers from shifting
             sideways as digits change at 4 Hz. -->
        <Style Selector="TextBlock.telemetry-value">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.telemetry-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.deck-button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.telemetry-unit">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6" Margin="10,8">

        <!-- Slice selector. The control surface targets an explicitly chosen
             slice: SmartStreamer runs Skimmer and WSJT-X per slice
             concurrently, so there is no single active slice to follow. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="Slice" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Slices}"
                      SelectedItem="{Binding SelectedSlice}"
                      HorizontalAlignment="Stretch"
                      FontSize="11">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="flex:SliceInfo">
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="11"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Grid.Column="0" Text="Mode" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Width="34"/>
            <UniformGrid Grid.Column="1" Columns="4" >
                <Button Classes="deck-button" Content="CW"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static flex:SliceMode.Cw}"/>
                <Button Classes="deck-button" Content="USB"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static flex:SliceMode.Usb}"/>
                <Button Classes="deck-button" Content="LSB"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static flex:SliceMode.Lsb}"/>
                <Button Classes="deck-button" Content="AM"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static flex:SliceMode.Am}"/>
            </UniformGrid>
        </Grid>

        <!-- Band buttons. A band change is a write to Slice.Freq, not an API
             verb, so the per-band memory behind these lives in BandMemory. -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Grid.Column="0" Text="Band" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Width="34"/>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Bands}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Classes="deck-button"
                                Content="{Binding}"
                                Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectBandCommand}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Grid.Column="0" Text="RX ant" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Width="34"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding RxAntennaOptions}"
                      SelectedItem="{Binding SelectedRxAntenna}"
                      HorizontalAlignment="Stretch"
                      FontSize="11"/>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Grid.Column="0" Text="TX ant" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Width="34"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TxAntennaOptions}"
                      SelectedItem="{Binding SelectedTxAntenna}"
                      HorizontalAlignment="Stretch"
                      FontSize="11"/>
        </Grid>

        <!-- RF gain. A panadapter property, not a slice one, and its range is
             radio-reported per panadapter rather than a per-model table. -->
        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6"
              IsEnabled="{Binding CanAdjustRfGain}">
            <TextBlock Grid.Column="0" Text="RF gain" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Width="46"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding RfGainText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Classes="deck-button" Content="&#x2212;" MinWidth="34"
                    Command="{Binding RfGainDownCommand}"/>
            <Button Grid.Column="3" Classes="deck-button" Content="+" MinWidth="34"
                    Command="{Binding RfGainUpCommand}"/>
        </Grid>

        <!-- AGC-T. Slice-scoped, unlike RF gain above, and its 0-100 range is
             fixed by the protocol rather than radio-reported. -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6"
              IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Grid.Column="0" Text="AGC-T" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Width="46"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding AgcThresholdText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Classes="deck-button" Content="&#x2212;" MinWidth="34"
                    Command="{Binding AgcThresholdDownCommand}"/>
            <Button Grid.Column="3" Classes="deck-button" Content="+" MinWidth="34"
                    Command="{Binding AgcThresholdUpCommand}"/>
        </Grid>

        <Grid Grid.Row="7" ColumnDefinitions="*,*,*,*" VerticalAlignment="Center">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Classes="telemetry-value" Text="{Binding PowerText}"/>
                    <TextBlock Classes="telemetry-unit" Text="W"/>
                </StackPanel>
                <TextBlock Classes="telemetry-label" Text="Power"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Classes="telemetry-value" Text="{Binding SwrText}"/>
                <TextBlock Classes="telemetry-label" Text="SWR"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Classes="telemetry-value" Text="{Binding TempText}"/>
                    <TextBlock Classes="telemetry-unit" Text="C"/>
                </StackPanel>
                <TextBlock Classes="telemetry-label" Text="Temp"/>
            </StackPanel>

            <StackPanel Grid.Column="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Classes="telemetry-value" Text="{Binding VoltsText}"/>
                    <TextBlock Classes="telemetry-unit" Text="V"/>
                </StackPanel>
                <TextBlock Classes="telemetry-label" Text="Volts"/>
            </StackPanel>
        </Grid>

        <!-- Top margin keeps this clear of the telemetry labels when the window
             is dragged down to its minimum height and the telemetry row's star
             sizing has no slack left to absorb. -->
        <CheckBox Grid.Row="8"
                  Name="AlwaysOnTopCheck"
                  Content="Always on top"
                  FontSize="10"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Right"
                  IsCheckedChanged="OnAlwaysOnTopChanged"/>
    </Grid>
</Window>
