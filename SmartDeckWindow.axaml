<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDRIQStreamer.App"
        mc:Ignorable="d" d:DesignWidth="360"
        x:Class="SDRIQStreamer.App.SmartDeckWindow"
        x:DataType="local:SmartDeckViewModel"
        Title="SmartDeck"
        Width="360" MinWidth="356"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <!-- Accelerators match the ones the operator already uses in FRStack.
         In-app only, by the phase-1 decision: no Win32 RegisterHotKey, so
         these fire while SmartDeck has focus and not while SmartSDR does. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding RfGainDownCommand}"/>
        <KeyBinding Gesture="F2" Command="{Binding RfGainUpCommand}"/>
        <KeyBinding Gesture="F3" Command="{Binding AgcThresholdDownCommand}"/>
        <KeyBinding Gesture="F4" Command="{Binding AgcThresholdUpCommand}"/>
    </Window.KeyBindings>

    <!-- The lit blue is no longer the deck's own brush: it is the app-wide
         accent from App.axaml, so the deck follows the Theme button like every
         other window (issue #63). It still means exactly one thing here, the
         value the radio currently holds. -->

    <Window.Styles>
        <!-- Telemetry readouts are glanced at mid-QSO. They sit a step below the
             RF gain and AGC-T readouts rather than matching them: matched, the
             footer competed with the controls above it (operator-reported, issue
             #59 live feedback). The step-down is the only part of that pass that
             survived. Spacing is untouched from the shipped layout, the tighter
             label margin tried alongside the move having gone back with it. -->
        <Style Selector="TextBlock.telemetry-value">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.telemetry-label">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.telemetry-unit">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,0,1"/>
        </Style>

        <!-- The mode readout is a control, not a caption: clicking it steps the
             slice through CW, LSB, USB, AM. It replaced a four-button row and
             its heading, which is the row the window got back (issue #59 live
             feedback). Deliberately not styled as a button, per the operator, so
             the only resting cue is that it reads as live state like the
             frequency beside it; the hover wash and the hand cursor are what
             say "clickable" before the click, because plain text that silently
             retunes the radio is otherwise a trap. -->
        <Style Selector="Button.mode-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <!-- Fluent gives a Button a 32px minimum height and a 1px border.
                 Both have to go or the readout stops being text: the minimum
                 would centre the mode inside a box taller than the frequency
                 beside it and push the whole header row down, which is the row
                 this control was added to save. -->
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Belt and braces with MinHeight above: if the template ever
                 hands the button a box taller than its text, the text still
                 sits on the row baseline instead of centring in the slack. -->
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="Button.mode-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mode-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mode-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- One heading per group, rather than a label beside every row: the
             40px gutter it replaces is 40px the buttons get back. -->
        <Style Selector="TextBlock.group-label">
            <Setter Property="FontSize" Value="10"/>
            <!-- Darker than the Gray these started at: at 10px that read as
                 disabled text rather than as a heading (operator-reported,
                 layout pass). Still well below the button labels, so the
                 headings name the group without competing with it. -->
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
            <Setter Property="Margin" Value="1,0,0,1"/>
        </Style>

        <!-- Uniform margin rather than a trailing one, so a row of buttons ends
             flush with the group above it instead of 4px short. The host panel
             cancels the outer edge with a matching negative margin. -->
        <Style Selector="Button.deck-button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Fluent's default button face is light enough that a grid of
                 small labels reads washed out at a glance. Weight and ink both
                 lift a step; the lit styles below still override both. -->
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource AppInkBrush}"/>
        </Style>
        <Style Selector="Button.deck-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppInkBrush}"/>
        </Style>

        <!-- "Lit" is the current value the radio holds, not a pressed state.
             Set on the templated ContentPresenter as well as the Button so the
             fill survives Fluent's own hover and pressed brushes. -->
        <Style Selector="Button.lit">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.lit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>
        <Style Selector="Button.lit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>
        <Style Selector="Button.lit:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
        </Style>

        <!-- Always-on-top as a pushpin: hollow and grey when off, its inside
             filled with the same lit blue as a selected band button when on.
             Drawn as a vector rather than an icon-font glyph because the font's
             pushpin codepoints are outlines, so recolouring one only tinted the
             outline and the on state was hard to see (operator-reported twice,
             layout pass). A filled box behind the pin was also tried and read
             as a sixth radio control. -->
        <Style Selector="ToggleButton.pin">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.pin Path">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource AppOutlineBrush}"/>
        </Style>
        <Style Selector="ToggleButton.pin:checked Path">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.pin /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- The pin itself lights, not the box behind it. A filled box was
             tried first and read as a sixth radio control (operator-reported,
             layout pass). -->
        <Style Selector="ToggleButton.pin:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.pin:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverWashBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" Margin="10,8">

        <!-- Header. Answers slice, frequency and mode without opening anything;
             before the layout pass that state lived inside the slice dropdown's
             label, which is the one place it could not be read at a glance. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <!-- The readout centres inside the middle column rather than
                 spanning all three. Spanning centred it on the window, which is
                 fractionally truer (the chips and the pin are different widths)
                 but let the chips overlap it once there were enough slices to
                 reach the middle. Adding "Mode" to the readout widened it by
                 roughly a chip, which moved that collision from four slices to
                 three, so the tradeoff no longer holds: at one slice the two
                 layouts differ by about a pixel, and this one cannot collide.
                 Still declared first so the chips and the pin draw over it if a
                 station ever runs enough slices to squeeze the column anyway. -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- Bottom-aligned explicitly rather than left on the default
                     Stretch. Stretched, it filled whatever height the mode
                     button claimed and drew its text at the top of that box,
                     while the button centred its own content, so the mode read
                     as sitting lower than the frequency (operator-reported,
                     issue #59 live feedback). Every item on this row is
                     bottom-aligned now, which is what puts the two on a common
                     baseline; do not drop this back to the default. -->
                <TextBlock Text="{Binding FrequencyText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                <TextBlock Text="MHz" FontSize="10" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                <!-- Mode repeats the frequency's value-then-unit shape one size
                     down, so the pair reads as two answers to "what am I on"
                     rather than a number with a suffix. Hidden rather than blank
                     with no slice, so the bare word "Mode" never sits alone. -->
                <Button Classes="mode-toggle"
                        IsVisible="{Binding HasSelectedSlice}"
                        Command="{Binding CycleModeCommand}"
                        ToolTip.Tip="Click to step the slice mode: CW, LSB, USB, AM"
                        Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModeText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Mode" FontSize="10" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding SliceOptions}" Margin="-2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeckOption">
                        <Button Classes="deck-button"
                                Classes.lit="{Binding IsCurrent}"
                                Content="{Binding Label}"
                                MinWidth="26"
                                Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectSliceCommand}"
                                CommandParameter="{Binding Label}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ToggleButton Grid.Column="2"
                          Name="AlwaysOnTopCheck"
                          Classes="pin"
                          ToolTip.Tip="Keep SmartDeck above other windows"
                          IsCheckedChanged="OnAlwaysOnTopChanged">
                <!-- Thumbtack seen head-on: cap, shaft, flange, needle. The
                     enclosed outline is the point, since the checked style
                     fills its interior rather than the button behind it. -->
                <Path Data="M8,2 L16,2 L16,4 L14.5,4 L14.5,9 L18,13 L18,14 L12.8,14 L12,22 L11.2,14 L6,14 L6,13 L9.5,9 L9.5,4 L8,4 Z"
                      Stretch="Uniform"
                      Height="16"
                      StrokeThickness="1.3"
                      StrokeJoin="Round">
                    <!-- Tilted so the needle points down-left, matching the
                         orientation the Windows pin glyph used. A render
                         transform rather than rotated path data, so the
                         geometry above stays readable as a thumbtack. -->
                    <Path.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Path.RenderTransform>
                </Path>
            </ToggleButton>
        </Grid>

        <!-- Band buttons. A band change is a write to Slice.Freq, not an API
             verb, so the per-band memory behind these lives in BandMemory. -->
        <StackPanel Grid.Row="1" IsEnabled="{Binding HasSelectedSlice}">
            <TextBlock Classes="group-label" Text="Band"/>
            <ItemsControl ItemsSource="{Binding BandOptions}" Margin="-2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeckOption">
                        <Button Classes="deck-button"
                                Classes.lit="{Binding IsCurrent}"
                                Content="{Binding Label}"
                                Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectBandCommand}"
                                CommandParameter="{Binding Label}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- RX and TX antenna share one row rather than owning one each: at two
             rows the deck stood twice the height of the operator's Stream Deck
             buttons beside it (issue #64). Antenna options come from the radio,
             so each group sizes itself to however many this model reports.
             The 2:1 column split matches the shape a 6600 reports once the
             transverter ports are filtered out (4 RX against 2 TX), so buttons
             read the same width across the seam; a radio reporting other counts
             renders one group slightly wider, which is cosmetic only. -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="10"
              IsEnabled="{Binding HasSelectedSlice}">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="group-label" Text="RX antenna"/>
                <ItemsControl ItemsSource="{Binding RxAntennaButtons}" Margin="-2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DeckOption">
                            <Button Classes="deck-button"
                                    Classes.lit="{Binding IsCurrent}"
                                    Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectRxAntennaCommand}"
                                    CommandParameter="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Classes="group-label" Text="TX antenna"/>
                <ItemsControl ItemsSource="{Binding TxAntennaButtons}" Margin="-2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DeckOption">
                            <Button Classes="deck-button"
                                    Classes.lit="{Binding IsCurrent}"
                                    Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((local:SmartDeckViewModel)DataContext).SelectTxAntennaCommand}"
                                    CommandParameter="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- RF gain is a panadapter property with a radio-reported range; AGC-T
             is slice-scoped with a protocol-fixed one. They pair here because
             both step an integer, and both carry their FRStack accelerator.
             TX power joins them as a readout with one button rather than a
             third stepper, so it takes only the width it needs.

             Each stepper brackets its own readout: minus, value, plus. The
             previous shape put both buttons after the value, which meant every
             group's "+" ended up flush against the *next* group's number, and
             the three groups overflowed their columns badly enough that the
             gutter between them collapsed to nothing. The value read as
             belonging to the buttons on its left rather than its right
             (operator-reported, issue #59 live feedback). Bracketing makes the
             grouping true at any spacing, so it cannot regress into the same
             ambiguity if a readout grows a digit. Do not move the buttons back
             to one side.

             Readouts keep a minimum width, now sized per group to its own
             widest real value rather than a shared 44px, so the buttons hold
             still as the number changes without the leftover slack reopening
             the gap this fixed. The min is a floor, not a cap: a wider value
             grows its Auto column instead of clipping. -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" IsEnabled="{Binding CanAdjustRfGain}">
                <TextBlock Classes="group-label" Text="RF gain"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="deck-button" Content="&#x2212;" MinWidth="30"
                            Command="{Binding RfGainDownCommand}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding RfGainText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               MinWidth="44"
                               Margin="2,0"/>
                    <Button Grid.Column="2" Classes="deck-button" Content="+" MinWidth="30"
                            Command="{Binding RfGainUpCommand}"/>
                </Grid>
            </StackPanel>

            <!-- Centred in the slack column so the two gutters either side of it
                 come out even, rather than piling all the leftover width on one
                 side of the row. -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" IsEnabled="{Binding HasSelectedSlice}">
                <TextBlock Classes="group-label" Text="AGC-T"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="deck-button" Content="&#x2212;" MinWidth="30"
                            Command="{Binding AgcThresholdDownCommand}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding AgcThresholdText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               MinWidth="24"
                               Margin="2,0"/>
                    <Button Grid.Column="2" Classes="deck-button" Content="+" MinWidth="30"
                            Command="{Binding AgcThresholdUpCommand}"/>
                </Grid>
            </StackPanel>

            <!-- The readout is the setting the radio will transmit at, which is
                 what the operator needs to see to know what QRP will give back.
                 The "Fwd" telemetry above is the measured forward power, a
                 different number. QRP lights while the deck is holding a power
                 to return to, and stands down on its own if the power changes
                 elsewhere. One labelled button rather than a stepper, so there
                 is no bracketing to do here. -->
            <StackPanel Grid.Column="2" IsEnabled="{Binding CanToggleQrp}">
                <TextBlock Classes="group-label" Text="TX power"/>
                <Grid ColumnDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding TxPowerText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               MinWidth="38"
                               Margin="2,0"/>
                    <Button Grid.Column="1"
                            Classes="deck-button"
                            Classes.lit="{Binding IsQrp}"
                            Content="QRP"
                            MinWidth="40"
                            ToolTip.Tip="Drop to 5 W and remember the current power. Press again to restore it."
                            Command="{Binding ToggleQrpCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Telemetry stays the footer, spread across the full width above its
             own top divider. Moving it up under the header and centring the four
             cells as a narrower group was tried on the operator's request and
             put back: the cluster it was meant to join did not read as one
             block, and the panel looked wrong in the position it was moved to
             (operator-reported twice, issue #59 live feedback). Only the font
             step-down from that attempt was kept. Padding and placement here are
             the shipped v0.3.0b2 values; do not move this again without the
             operator asking for it specifically. -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0" Padding="0,5,0,0">
            <Grid ColumnDefinitions="*,*,*,*">
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Classes="telemetry-value" Text="{Binding PowerText}"/>
                        <TextBlock Classes="telemetry-unit" Text="W"/>
                    </StackPanel>
                    <!-- "Fwd", not "Power": the TX power group above is the
                         setting, this is what the meter reads coming out. -->
                    <TextBlock Classes="telemetry-label" Text="Fwd"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Classes="telemetry-value" Text="{Binding SwrText}"/>
                    <TextBlock Classes="telemetry-label" Text="SWR"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Classes="telemetry-value" Text="{Binding TempText}"/>
                        <TextBlock Classes="telemetry-unit" Text="C"/>
                    </StackPanel>
                    <TextBlock Classes="telemetry-label" Text="Temp"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Classes="telemetry-value" Text="{Binding VoltsText}"/>
                        <TextBlock Classes="telemetry-unit" Text="V"/>
                    </StackPanel>
                    <TextBlock Classes="telemetry-label" Text="Volts"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
